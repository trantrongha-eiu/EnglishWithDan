    {
      "code": "NP-L01-E02",
      "lessonCode": "NP-L01",
      "order": 2,
      "type": "mcq",
      "title": "Luật number / amount / figure / percentage",
      "instruction": "Chọn đáp án đúng.",
      "autoGrade": true,
      "points": 10,
      "estimatedMinutes": 5,
      "difficulty": 1,
      "skillTags": [
        "noun-choice"
      ],
      "items": [
        {
          "id": "q1",
          "prompt": "Điền: \"The ____ of coffee exported from Vietnam reached 1.5 million tonnes.\"",
          "options": [
            {
              "id": "A",
              "text": "number"
            },
            {
              "id": "B",
              "text": "amount"
            },
            {
              "id": "C",
              "text": "figure"
            },
            {
              "id": "D",
              "text": "percentage"
            }
          ],
          "answer": "B",
          "explanation": "coffee không đếm được → the amount of."
        },
        {
          "id": "q2",
          "prompt": "Điền: \"The ____ of households owning a car doubled over the period.\"",
          "options": [
            {
              "id": "A",
              "text": "amount"
            },
            {
              "id": "B",
              "text": "number"
            },
            {
              "id": "C",
              "text": "figure"
            },
            {
              "id": "D",
              "text": "proportion"
            }
          ],
          "answer": "B",
          "explanation": "households đếm được số nhiều → the number of."
        },
        {
          "id": "q3",
          "prompt": "Cụm nào ĐÚNG?",
          "options": [
            {
              "id": "A",
              "text": "the figure of Japan"
            },
            {
              "id": "B",
              "text": "the figure for Japan"
            },
            {
              "id": "C",
              "text": "the figure in Japan"
            },
            {
              "id": "D",
              "text": "the figure about Japan"
            }
          ],
          "answer": "B",
          "explanation": "\"the figure FOR + đối tượng\" — giới từ FOR, không phải OF."
        },
        {
          "id": "q4",
          "prompt": "Sau \"the number of\" thì danh từ phải ở dạng nào và động từ chia ra sao?",
          "options": [
            {
              "id": "A",
              "text": "số nhiều + động từ số nhiều"
            },
            {
              "id": "B",
              "text": "số ít + động từ số ít"
            },
            {
              "id": "C",
              "text": "số nhiều + động từ số ít"
            },
            {
              "id": "D",
              "text": "số ít + động từ số nhiều"
            }
          ],
          "answer": "C",
          "explanation": "the number of cars WAS… — danh từ số nhiều nhưng head noun \"number\" số ít nên động từ số ít."
        },
        {
          "id": "q5",
          "prompt": "Với kết quả là 12%, ta dùng danh từ nào?",
          "options": [
            {
              "id": "A",
              "text": "the number of"
            },
            {
              "id": "B",
              "text": "the amount of"
            },
            {
              "id": "C",
              "text": "the percentage / proportion of"
            },
            {
              "id": "D",
              "text": "the figure of"
            }
          ],
          "answer": "C",
          "explanation": "Dữ liệu phần trăm → the percentage / proportion / rate of."
        }
      ]
    },
